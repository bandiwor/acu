+> "io" => io;
+> "sys" => sys;
+> "math" => math;

{
    // =========================================================================
    // 1. Секция Host / Интроспекция (Маркер 111)
    // =========================================================================
    io.printU64(111);
    io.println();

    $pid = sys.pid();
    io.printI64(pid);
    io.println();

    $cpus = sys.cpuCount();
    io.printU64(cpus);
    io.println();

    $epoch_sec = sys.timeSec();
    io.printU64(epoch_sec);
    io.println();

    // =========================================================================
    // 2. Секция PRNG (Маркер 222)
    // =========================================================================
    io.printU64(222);
    io.println();

    sys.randomSeed(1337);
    $r1 = sys.randomU64();
    $r2 = sys.randomU64();

    io.printU64(r1);
    io.println();
    io.printU64(r2);
    io.println();

    // =========================================================================
    // 3. Секция Math F64 (Маркер 333)
    // =========================================================================
    io.printU64(333);
    io.println();

    $sqrt_16 = math.sqrt(16.0);    // Ожидается: 4.0
    io.printF64(sqrt_16);
    io.println();

    $pow_2_10 = math.pow(2.0, 10.0); // Ожидается: 1024.0
    io.printF64(pow_2_10);
    io.println();

    $sin_0 = math.sin(0.0);        // Ожидается: 0.0
    io.printF64(sin_0);
    io.println();

    $cos_0 = math.cos(0.0);        // Ожидается: 1.0
    io.printF64(cos_0);
    io.println();

    // =========================================================================
    // 4. Секция Sleep + Тайминг (Маркер 444)
    // =========================================================================
    io.printU64(444);
    io.println();

    $t0 = sys.clockNs();
    sys.sleepMs(50);
    $elapsed_ns = sys.clockNs() - t0;

    // Ожидается: ~50_000_000 нс (плюс оверхед планировщика ОС)
    io.printU64(elapsed_ns);
    io.println();
}
